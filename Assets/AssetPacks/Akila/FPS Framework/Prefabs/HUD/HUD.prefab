  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0422\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0430
    \xAB\u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u044B\u0445\xBB \u043D\u0435
    \u043E\u0431\u043E\u0448\u043B\u0430\u0441\u044C \u0431\u0435\u0437 \u043A\u0430\u0437\u0443\u0441\u043E\u0432.
    \u041A\u0442\u043E \u0431\u044B \u043C\u043E\u0433 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C.
    \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
    \u0431\u044B\u043B\u0438 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u043D\u044B.
    \u0422\u0440\u043E\u0435 \u0438\u0437 \u043D\u0438\u0445 \u0431\u044B\u043B\u0438
    \u0441\u0432\u0438\u0440\u0435\u043F\u043E \u0443\u0431\u0438\u0442\u044B. \u041D\u043E
    \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0435
    \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E. \u042D\u0442\u043E \u0431\u044B\u043B\u0430
    \u0442\u0440\u0430\u043F\u0435\u0437\u0430. \u041F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0447\u0442\u043E \u043C\u044B \u0432\u0432\u043E\u0434\u0438\u043B\u0438
    \u0432 \xAB\u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u044B\u0445\xBB,
    \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u0431\u044B\u043B\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
    \u0418\u043C \u043D\u0443\u0436\u043D\u0430 \u0431\u044B\u043B\u0430 \u043F\u043B\u043E\u0442\u044C.
    \u041E\u0434\u043D\u043E\u043C\u0443 \u0431\u0435\u0434\u043E\u043B\u0430\u0433\u0435
    \u043E\u0442\u043E\u0440\u0432\u0430\u043B\u0438 \u0440\u0443\u043A\u0443, \u0430
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0431\u0438\u043B\u0438 \u0442\u0435\u043B\u043E
    \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C \u043E\u0434\u043D\u0438\u043C
    \u0443\u0434\u0430\u0440\u043E\u043C. \u0412\u0441\u0451 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u043E
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0431\u044B\u0441\u0442\u0440\u043E,
    \u0447\u0442\u043E \u0432 \u0434\u043E\u043B\u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439
    \xAB\u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u044B\u0439\xBB \u043F\u0440\u0438\u043D\u044F\u043B\u0441\u044F
    \u0435\u0441\u0442\u044C \u0435\u0433\u043E \u043B\u0438\u0446\u043E. \u0425\u043E\u0442\u044F
    \u044D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u043C\u044F\u0433\u043A\u043E
    \u0441\u043A\u0430\u0437\u0430\u043D\u043E. \u0412\u0435\u0434\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u0441
    \u0431\u044B\u043B \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0438\u043A\u0438\u0439
    \u0438 \u0437\u0432\u0435\u0440\u0441\u043A\u0438\u0439, \u0447\u0442\u043E \u043A\u0430\u043A
    \u0431\u0443\u0434\u0442\u043E \u043D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0439
    \u043D\u0435 \u0435\u043B \u043D\u0438\u0447\u0435\u0433\u043E \u043C\u0435\u0441\u044F\u0446\u0430\u043C\u0438.
    \u041F\u043E\u043A\u0430 \u0431\u0435\u0436\u0430\u043B\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u044B,
    \u044D\u0442\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u043D\u0430\u043F\u0430\u043B\u0430
    \u043D\u0430 \u0434\u0432\u0443\u0445 \u043B\u0430\u0431\u043E\u0440\u0430\u043D\u0442\u043E\u043A.
    \u042F \u0447\u0443\u0434\u043E\u043C \u0443\u0446\u0435\u043B\u0435\u043B. \u0415\u0441\u043B\u0438
    \u0431\u044B \u044F \u043D\u0435 \u043E\u0442\u043E\u0448\u0451\u043B \u043D\u0430\u0437\u0430\u0434
    \u0432\u0433\u043B\u0443\u0431\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    \u0437\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438,
    \u0433\u0434\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
    \xAB\u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u044B\u0435\xBB, \u0442\u043E
    \u044F \u0431\u044B \u0442\u043E\u0447\u043D\u043E \u0431\u044B\u043B \u043C\u0451\u0440\u0442\u0432.
    \n"
