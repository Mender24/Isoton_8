  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
    \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0442\u0435\u0445\u043D\u0438\u043A\u0438
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. \u0413\u0440\u0443\u043F\u043F\u0430
    \u0441 \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0432\u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u0432 \u0431\u043B\u0438\u0437\u043A\u0438\u0439
    \u043D\u0435\u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0430\u043A\u0442
    \u0441 \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u043E\u043C \u0418\u0437\u043E\u0442\u043E\u043D-8.
    \u0412 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0447\u0435\u0433\u043E
    \u043A \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u043C \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u043C
    \u0431\u043E\u043B\u044F\u043C \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438\u0441\u044C
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B.
    \u0410 \u0438\u043C\u0435\u043D\u043D\u043E, \u043F\u0430\u0440\u0430\u043D\u043E\u0439\u044F,
    \u0442\u043E\u0448\u043D\u043E\u0442\u0430, \u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0435
    \u0432\u044B\u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u0432\u043E\u043B\u043E\u0441,
    \u043E\u0442\u0442\u0435\u043D\u043E\u043A \u043A\u043E\u0436\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0431\u043B\u0435\u0434\u043D\u0435\u0439. \u0418 \u043C\u043E\u0435 \u0441\u0430\u043C\u043E\u0435
    \u043B\u044E\u0431\u0438\u043C\u043E\u0435- \u044D\u0442\u043E \u0448\u0438\u0437\u043E\u0444\u0440\u0435\u043D\u0438\u044F.
    \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u044D\u0442\u043E\u0442
    \u043C\u0438\u043D\u0435\u0440\u0430\u043B \u043F\u043E\u043C\u0438\u043C\u043E
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043C\u043E\u0436\u0435\u0442 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u0433\u0435\u043D\u043E\u043C \u0436\u0438\u0432\u044B\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432?
    \u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u0442\u0430\u043A, \u0442\u043E
    \u043C\u044B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043C
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0432 \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u043A\u0435,
    \u043D\u043E \u0438 \u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0438."
